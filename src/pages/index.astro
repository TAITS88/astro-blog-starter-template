---
import Site from "../layouts/Site.astro";
import { SITE, whatsappLink, mailLink, DEFAULT_WHATSAPP } from "../data/site";

// Approved reviews are read straight from D1 on the server, so they are in the
// HTML for Google and there is no flash of placeholder content.
type Review = { id: number; name: string; project: string; rating: number; message: string; created_at: string };
let reviews: Review[] = [];
try {
  const db = (Astro.locals as any)?.runtime?.env?.DB;
  if (db) {
    const result = await db
      .prepare(
        `SELECT id, name, project, rating, message, created_at
         FROM testimonials WHERE approved = 1
         ORDER BY created_at DESC LIMIT 12`
      )
      .all();
    reviews = (result?.results as Review[]) || [];
  }
} catch {
  reviews = [];
}

const stars = (n: number) => {
  const r = Math.max(1, Math.min(5, Math.round(Number(n) || 5)));
  return "★".repeat(r) + "☆".repeat(5 - r);
};

const commercialWhatsApp = whatsappLink(
  "Hi WhichwoodFitters, I have a commercial fitout to price. I can send the drawings / BOQ.\n\nProject:\nLocation:\nTimeline:"
);
const commercialMail = mailLink(
  "Commercial fitout - drawings for pricing",
  "Hi WhichwoodFitters,\n\nPlease find attached drawings for pricing.\n\nProject / store:\nSite location:\nRequired completion date:\nContact person:\n\nThank you."
);

const residential = [
  { title: "Kitchens", text: "Base, wall and tall units planned around your appliances, plumbing, plugs and how you cook.", image: "/images/kitchens/kitchen-09.jpg", alt: "Light fitted kitchen with an island and pendant lights" },
  { title: "Built-in cupboards", text: "Wall-to-wall bedroom cupboards with hanging, shelving and drawer sections laid out to your room.", image: "/images/cupboards/cupboard-03.jpg", alt: "White built-in bedroom cupboards with drawers and open shelving" },
  { title: "TV & wall units", text: "Floating TV units, display shelving and feature walls sized to your wall and screen.", image: "/images/tv-units/tv-unit-04.jpg", alt: "Floating TV unit with wood-look panel and shelving" },
  { title: "Vanities", text: "Bathroom vanities made to the space — single or double basin, drawers or open shelf.", image: "/images/vanities/vanity-01.jpg", alt: "Wall-hung bathroom vanity with wood-look finish" },
  { title: "Laundry & scullery", text: "Units around the washer and dryer, tall broom cupboards and sculleries that keep things off the floor.", image: "/images/storage/storage-11.jpg", alt: "Laundry cupboards built around a washing machine and dryer" },
  { title: "Home office & storage", text: "Desks, shelving, pantry units and under-stair storage that use awkward space properly.", image: "/images/storage/storage-08.jpg", alt: "Built-in home office desk with shelving" }
];

const commercial = [
  { title: "Pharmacy fitouts", text: "Dispensary units, drawer banks and storage built to the shopfitting drawings.", image: "/images/commercial/dispensary.svg", alt: "Line drawing of a pharmacy dispensary unit with shelving above and drawers below" },
  { title: "Retail & shopfitting", text: "Front-shop wall bays, display shelving and back-of-house storage.", image: "/images/commercial/wall-shelving.svg", alt: "Line drawing of front-shop wall shelving bays" },
  { title: "Counters & till points", text: "Service counters, cash-wrap and dispensing counters with screens.", image: "/images/commercial/counter.svg", alt: "Line drawing of a service counter with till and screen" },
  { title: "Consulting rooms & offices", text: "Clinic rooms, reception desks, workstations and storage. Coffee shops and kitchenettes too.", image: "/images/commercial/consulting-room.svg", alt: "Line drawing of consulting room joinery with overhead cupboards, desk and basin" }
];

const P = "/images/projects/sun-city-pharmacy/";
const sunCityVideos = [
  { src: P + "walkthrough.mp4", poster: P + "walkthrough-poster.jpg", title: "Shop walkthrough", note: "Gondolas, store rooms and wall shelving", length: "1:35" },
  { src: P + "counters-dispensary.mp4", poster: P + "counters-dispensary-poster.jpg", title: "Counters & dispensary", note: "Service counters, dispensary shelving, staff kitchen", length: "1:02" },
  { src: P + "install-in-progress.mp4", poster: P + "install-in-progress-poster.jpg", title: "Install in progress", note: "Units arriving and going in on site", length: "0:31" }
];
const sunCityPhotos = [
  { src: P + "counters-and-shelving.jpg", alt: "Orange service counters and wall shelving being installed", caption: "Service counters", w: 1400, h: 1050, col: 4 },
  { src: P + "wall-shelving-install.jpg", alt: "Front-shop wall shelving during installation", caption: "Wall shelving", w: 1400, h: 1050, col: 4 },
  { src: P + "shop-floor-in-progress.jpg", alt: "Pharmacy shop floor with counters and gondola units in progress", caption: "Shop floor", w: 1054, h: 1400, col: 3 },
  { src: P + "bulkhead-and-wall-panels.jpg", alt: "Bulkhead and wall panels fitted in the pharmacy", caption: "Bulkhead & panels", w: 1054, h: 1400, col: 3 }
];

const standards = [
  { no: "01", title: "Measured before we build", text: "Final measurements are taken on site and confirmed before anything goes into manufacturing." },
  { no: "02", title: "Built to your drawing", text: "Commercial work is built box for box to the drawing sizes. No guessed parts, no swapped sizes." },
  { no: "03", title: "Clear quotes", text: "Every unit on the quote is described, so you know exactly what you are paying for." },
  { no: "04", title: "Neat installation", text: "Units are levelled, scribed and aligned on site, and the area is left clean." }
];

const steps = [
  { no: "1", title: "Send your space or drawings", text: "WhatsApp photos and rough sizes, or send the architect / shopfitter drawings." },
  { no: "2", title: "Receive your quote", text: "A written quote describing every unit, finish and what is included." },
  { no: "3", title: "Site measure & sign-off", text: "We confirm final measurements on site and you sign off the layout and finishes." },
  { no: "4", title: "Deposit & manufacture", text: "A 75% deposit secures your slot and materials. Units are then cut and built." },
  { no: "5", title: "Install & hand over", text: "Units are installed and adjusted. The 25% balance is due on completion." }
];

const finishes = [
  { value: "White melamine", label: "White", note: "Clean and bright", swatch: "#f7f7f5" },
  { value: "Light grey melamine", label: "Light grey", note: "Soft neutral", swatch: "#cfcfcc" },
  { value: "Black melamine", label: "Black", note: "Bold, modern", swatch: "#1d1d1d" },
  { value: "Oak / wood-look melamine", label: "Oak / wood-look", note: "Warm, natural", swatch: "linear-gradient(135deg,#b88654,#8a5a32 60%,#a87545)" },
  { value: "SupaGloss / high-gloss", label: "High gloss", note: "Reflective finish", swatch: "linear-gradient(135deg,#ffffff,#d9dde2 55%,#ffffff)" },
  { value: "Not sure yet - need advice", label: "Not sure", note: "Advise me", swatch: "repeating-linear-gradient(45deg,#eee 0 6px,#ddd 6px 12px)" }
];
---

<Site
  title="WhichwoodFitters | Custom Kitchens, Cupboards & Shop Fitouts in Pretoria"
  description="WhichwoodFitters builds custom kitchens, built-in cupboards, vanities and TV units, plus pharmacy, retail and office fitouts. Based in Sinoville, Pretoria, serving Gauteng."
  path="/"
>
  <style>
    /* Hero */
    .hero { padding: clamp(40px, 6vw, 80px) 0 clamp(56px, 7vw, 96px); border-bottom: 1px solid var(--line); }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
    .hero h1 span { color: var(--red); }
    .hero-lead { font-size: 1.15rem; color: var(--ink-2); margin: 22px 0 30px; max-width: 34em; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .hero-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 40px; border-top: 1px solid var(--line); }
    .hero-facts div { padding: 18px 16px 0 0; }
    .hero-facts strong { display: block; font-size: .95rem; }
    .hero-facts span { font-size: .87rem; color: var(--muted); }
    .hero-media { position: relative; }
    .hero-media img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--radius); }
    .hero-media::after { content: ""; position: absolute; left: -14px; bottom: -14px; width: 42%; height: 42%; border-left: 4px solid var(--red); border-bottom: 4px solid var(--red); pointer-events: none; }
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-media { order: -1; }
      .hero-media::after { display: none; }
    }
    @media (max-width: 560px) { .hero-facts { grid-template-columns: 1fr; } .hero-facts div { padding: 14px 0 0; } .hero-actions .btn { flex: 1 1 100%; } }

    /* Split audience */
    .split { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .split a { display: block; padding: 32px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; background: #fff; transition: border-color .15s, transform .15s; }
    .split a:hover { border-color: var(--ink); transform: translateY(-2px); }
    .split small { color: var(--red); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: .75rem; }
    .split h3 { margin: 10px 0 8px; font-size: 1.6rem; }
    .split p { color: var(--muted); }
    .split .go { display: inline-block; margin-top: 16px; font-weight: 600; }
    @media (max-width: 760px) { .split { grid-template-columns: 1fr; } }

    /* Residential cards */
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
    .card img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
    .card div { padding: 20px 22px 24px; }
    .card p { margin-top: 8px; color: var(--muted); font-size: .96rem; }
    .section-foot { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .note { font-size: .82rem; color: var(--muted); }
    @media (max-width: 960px) { .cards { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .cards { grid-template-columns: 1fr; } }

    /* Commercial */
    .com-grid { display: grid; grid-template-columns: 1fr 1.35fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
    .com-grid .lead { font-size: 1.1rem; margin: 18px 0 28px; color: #d6d6d6; }
    .com-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .com-card { margin: 0; border: 1px solid #2e2e2e; border-radius: var(--radius); overflow: hidden; background: #161616; }
    .com-card img { width: 100%; aspect-ratio: 10 / 7; object-fit: cover; }
    .com-card figcaption { padding: 14px 16px 18px; border-top: 1px solid #2e2e2e; }
    .com-card h3 { font-size: 1.1rem; }
    .com-card p { color: #b9b9b9; margin-top: 4px; font-size: .92rem; }
    @media (max-width: 560px) { .com-cards { grid-template-columns: 1fr; } }
    .com-send { margin-top: 28px; padding: 22px; border: 1px solid #333; border-radius: var(--radius); }
    .com-send h3 { font-size: 1.05rem; font-family: var(--sans); font-weight: 700; }
    .com-send ul { margin: 10px 0 0; padding-left: 18px; color: #b9b9b9; }
    .com-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    @media (max-width: 900px) { .com-grid { grid-template-columns: 1fr; } }

    /* Featured project */
    .fp { background: var(--paper-2); }
    .fp-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px 64px; align-items: end; margin-bottom: 40px; }
    .fp-head p { margin-top: 16px; font-size: 1.06rem; max-width: 36em; }
    .fp-facts { margin: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid var(--ink); }
    .fp-facts div { padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); }
    .fp-facts .wide { grid-column: 1 / -1; }
    .fp-facts dt { font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--red); }
    .fp-facts dd { margin: 4px 0 0; font-weight: 500; }

    .reels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .reel { margin: 0; }
    .reel-media { position: relative; aspect-ratio: 9 / 16; border-radius: 10px; overflow: hidden; background: #111; box-shadow: 0 18px 50px rgba(0,0,0,.18); }
    .reel-media video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .reel-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,.55)); pointer-events: none; transition: opacity .2s; }
    .reel.playing .reel-media::after, .reel.playing .reel-play, .reel.playing .reel-len { opacity: 0; pointer-events: none; }
    .reel-play {
      position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 2;
      width: 76px; height: 76px; border-radius: 50%; border: 0; cursor: pointer;
      background: var(--red); color: #fff; display: grid; place-items: center;
      box-shadow: 0 0 0 10px rgba(200,16,46,.25); transition: transform .15s, opacity .2s;
    }
    .reel-play:hover { transform: scale(1.06); }
    .reel-play svg { width: 30px; height: 30px; margin-left: 4px; }
    .reel-len { position: absolute; right: 12px; bottom: 12px; z-index: 2; color: #fff; font: 600 .8rem var(--sans); background: rgba(0,0,0,.55); padding: 4px 8px; border-radius: 4px; transition: opacity .2s; }
    .reel figcaption { display: flex; gap: 14px; align-items: baseline; padding: 16px 4px 0; }
    .reel-no { font: 700 .85rem var(--sans); color: var(--red); }
    .reel figcaption strong { display: block; font: 700 1.15rem/1.3 var(--serif); }
    .reel figcaption span:not(.reel-no) { color: var(--muted); font-size: .92rem; }

    .fp-photos { display: grid; grid-template-columns: 4fr 4fr 3fr 3fr; gap: 12px; margin-top: 32px; }
    .fp-photos a { position: relative; display: block; border-radius: 8px; overflow: hidden; background: #ddd; text-decoration: none; }
    .fp-photos img { width: 100%; height: 260px; object-fit: cover; transition: transform .35s; }
    .fp-photos a:hover img { transform: scale(1.04); }
    .fp-photos span { position: absolute; left: 10px; bottom: 10px; background: rgba(17,17,17,.82); color: #fff; font: 600 .78rem var(--sans); padding: 5px 9px; border-radius: 4px; }

    .fp-foot { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; justify-content: space-between; padding: 24px 28px; background: var(--ink); color: #fff; border-radius: 10px; }
    .fp-foot p { font: 700 1.3rem var(--serif); }

    @media (max-width: 900px) {
      .fp-head { grid-template-columns: 1fr; }
      .reels { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; gap: 14px; margin-inline: -20px; padding: 0 20px 8px; scrollbar-width: none; }
      .reels::-webkit-scrollbar { display: none; }
      .reel { flex: 0 0 68%; scroll-snap-align: start; }
      .fp-photos { grid-template-columns: 1fr 1fr; }
      .fp-photos img { height: 200px; }
    }
    @media (max-width: 480px) { .reel { flex-basis: 78%; } .fp-photos img { height: 160px; } .fp-foot .btn { width: 100%; } }

    /* Standards */
    .std { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 2px solid var(--ink); }
    .std article { padding: 24px 24px 0 0; }
    .std span { font: 700 .85rem var(--sans); color: var(--red); }
    .std h3 { margin: 10px 0 8px; font-size: 1.15rem; }
    .std p { color: var(--muted); font-size: .95rem; }
    @media (max-width: 900px) { .std { grid-template-columns: 1fr 1fr; row-gap: 12px; } }
    @media (max-width: 560px) { .std { grid-template-columns: 1fr; } }

    /* Process */
    .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; counter-reset: s; }
    .steps li { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
    .steps b { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: #fff; font-size: .9rem; }
    .steps h3 { font-size: 1.05rem; margin: 14px 0 6px; font-family: var(--sans); font-weight: 700; }
    .steps p { color: var(--muted); font-size: .92rem; }
    @media (max-width: 1060px) { .steps { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 680px) { .steps { grid-template-columns: 1fr; } }

    /* Estimate */
    .est { display: grid; grid-template-columns: 1.25fr 1fr; gap: 28px; align-items: start; }
    .est-form { display: grid; gap: 22px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 3vw, 32px); }
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .row-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .checks { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid #cfccc6; border-radius: 999px; cursor: pointer; font-size: .92rem; user-select: none; }
    .chip:has(input:checked) { border-color: var(--ink); background: var(--ink); color: #fff; }
    .chip input { accent-color: var(--red); }
    .finishes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .finish { display: flex; gap: 10px; align-items: center; padding: 10px; border: 1px solid #cfccc6; border-radius: var(--radius); cursor: pointer; }
    .finish:has(input:checked) { border-color: var(--red); box-shadow: inset 0 0 0 1px var(--red); }
    .finish input { position: absolute; opacity: 0; pointer-events: none; }
    .finish i { width: 32px; height: 32px; border-radius: 4px; border: 1px solid #0002; flex: none; }
    .finish strong { display: block; font-size: .9rem; line-height: 1.2; }
    .finish small { color: var(--muted); font-size: .78rem; }
    .photo-drop { border: 1px dashed #b8b4ad; border-radius: var(--radius); padding: 18px; background: var(--paper-2); display: grid; gap: 10px; }
    .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 8px; }
    .thumbs img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
    .est-preview { position: sticky; top: 92px; background: var(--ink); color: #fff; border-radius: var(--radius); padding: clamp(20px, 3vw, 28px); display: grid; gap: 16px; }
    .est-preview pre { margin: 0; white-space: pre-wrap; word-break: break-word; font: 400 .86rem/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: #1d1d1d; padding: 16px; border-radius: 4px; max-height: 420px; overflow: auto; color: #e9e9e9; }
    .est-preview p { color: #b9b9b9; font-size: .88rem; }
    @media (max-width: 960px) { .est { grid-template-columns: 1fr; } .est-preview { position: static; } }
    @media (max-width: 600px) { .row-2, .row-3 { grid-template-columns: 1fr; } .finishes { grid-template-columns: 1fr 1fr; } }

    /* Reviews */
    .rev { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: start; }
    .rev.empty { grid-template-columns: 1fr; max-width: 640px; }
    .rev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .rev-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; background: #fff; }
    .rev-card .s { color: var(--red); letter-spacing: 2px; }
    .rev-card p { margin: 10px 0 14px; }
    .rev-card footer { font-size: .88rem; color: var(--muted); }
    .rev-card footer strong { color: var(--ink); }
    .rev-form { display: grid; gap: 16px; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; background: var(--paper-2); }
    .rev-form h3 { font-size: 1.4rem; }
    .rev-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    @media (max-width: 900px) { .rev { grid-template-columns: 1fr; } }
    @media (max-width: 600px) { .rev-grid { grid-template-columns: 1fr; } }

    /* Contact band */
    .contact-band { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
    .contact-band .lead { color: #cfcfcf; margin-top: 16px; font-size: 1.08rem; }
    .contact-list { display: grid; gap: 12px; }
    .contact-list .btn { justify-content: space-between; width: 100%; }
    @media (max-width: 860px) { .contact-band { grid-template-columns: 1fr; } }
  </style>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Custom joinery · Pretoria</span>
        <h1>Kitchens, cupboards and fitouts, <span>built to fit.</span></h1>
        <p class="hero-lead">
          WhichwoodFitters makes and installs custom kitchens, built-in cupboards and vanities for
          homes, and joinery for pharmacies, shops and offices. Measured properly, built to the
          drawing, installed neatly.
        </p>
        <div class="hero-actions">
          <a class="btn btn-red" href={DEFAULT_WHATSAPP} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91A9.86 9.86 0 0 0 12.04 2Zm5.8 14.06c-.24.68-1.42 1.3-1.95 1.35-.5.05-.97.23-3.27-.68-2.77-1.09-4.52-3.92-4.66-4.1-.13-.18-1.1-1.47-1.1-2.81s.7-1.99.95-2.27c.25-.27.54-.34.72-.34h.52c.17 0 .4-.06.62.47.24.56.8 1.94.86 2.08.07.14.12.3.02.48-.09.18-.14.3-.27.46l-.41.48c-.14.14-.28.29-.12.56.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.2 1.36.27.14.43.11.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.66-.17 1.33Z"/></svg>
            WhatsApp for a quote
          </a>
          <a class="btn btn-line" href="#estimate">Build a quick estimate</a>
        </div>
        <div class="hero-facts">
          <div><strong>Registered company</strong><span>{SITE.legalName.replace("WhichwoodFitters ", "")} since 2019</span></div>
          <div><strong>Homes & businesses</strong><span>Residential and commercial</span></div>
          <div><strong>Quotes from photos</strong><span>or from your drawings</span></div>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/kitchens/kitchen-02.jpg" width="1200" height="720" alt="Fitted kitchen with wood-look cupboards and a white island" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="section" style="padding-bottom:0">
    <div class="wrap split">
      <a href="#residential">
        <small>For homeowners</small>
        <h3>Residential joinery</h3>
        <p>Kitchens, bedroom cupboards, TV units, vanities, laundries and storage — made to your space.</p>
        <span class="go">See what we build →</span>
      </a>
      <a href="#commercial">
        <small>For businesses & contractors</small>
        <h3>Commercial fitouts</h3>
        <p>Pharmacy, retail, office and coffee-shop joinery, priced and built from your drawings.</p>
        <span class="go">Send us your drawings →</span>
      </a>
    </div>
  </section>

  <!-- RESIDENTIAL -->
  <section class="section" id="residential">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Residential</span>
        <h2>Made for your space, not a catalogue.</h2>
        <p class="muted">Every unit is sized to the actual wall, ceiling and floor — including the plugs, pipes, corners and skirtings that off-the-shelf units ignore.</p>
      </div>
      <div class="cards">
        {residential.map((item) => (
          <article class="card">
            <img src={item.image} width="1200" height="720" alt={item.alt} loading="lazy" decoding="async" />
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="section-foot">
        <a class="btn btn-dark" href="/gallery">Browse styles & finishes</a>
        <a class="btn btn-line" href="#estimate">Get an estimate</a>
      </div>
    </div>
  </section>

  <!-- COMMERCIAL -->
  <section class="section section-dark" id="commercial">
    <div class="wrap com-grid">
      <div>
        <span class="eyebrow">Commercial</span>
        <h2>Shop and pharmacy fitouts, built to the drawing.</h2>
        <p class="lead">
          We work from your architect or shopfitter drawings and price unit by unit, so the quote
          lines up with the plan. Units are built box for box to the drawing sizes and installed to
          your programme.
        </p>
        <div class="com-actions">
          <a class="btn btn-red" href={commercialWhatsApp} target="_blank" rel="noopener noreferrer">Send drawings on WhatsApp</a>
          <a class="btn btn-line-light" href={commercialMail}>Email drawings</a>
        </div>
        <div class="com-send">
          <h3>To price quickly, send:</h3>
          <ul>
            <li>Joinery drawings or elevations (PDF)</li>
            <li>Board colours / finishes schedule, if specified</li>
            <li>Site address and required completion date</li>
          </ul>
        </div>
      </div>
      <div>
        <div class="com-cards">
          {commercial.map((item) => (
            <figure class="com-card">
              <img src={item.image} width="800" height="560" alt={item.alt} loading="lazy" decoding="async" />
              <figcaption>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="muted" style="padding-top:18px;font-size:.92rem">
          Based in Pretoria. Work outside Gauteng by arrangement.
        </p>
      </div>
    </div>

  </section>

  <!-- FEATURED PROJECT -->
  <section class="section fp" id="project">
    <div class="wrap">
      <div class="fp-head">
        <div>
          <span class="eyebrow">Featured project</span>
          <h2>The Local Choice Pharmacy, Sun City</h2>
          <p class="muted">A full pharmacy fitout inside the Sun City Resort entertainment centre — built to the shopfitting drawings, with the resort's site rules and a fixed handover date.</p>
        </div>
        <dl class="fp-facts">
          <div><dt>Location</dt><dd>Sun City Resort, North West</dd></div>
          <div><dt>Completed</dt><dd>September 2026</dd></div>
          <div class="wide"><dt>Scope</dt><dd>Service counters, dispensary units, wall shelving, store rooms, bulkheads and wall panels</dd></div>
        </dl>
      </div>

      <div class="reels" role="list">
        {sunCityVideos.map((v, i) => (
          <figure class="reel" role="listitem">
            <div class="reel-media">
              <video src={v.src} poster={v.poster} preload="none" playsinline muted width="720" height="1280" aria-label={`${v.title} video`}></video>
              <button class="reel-play" type="button" aria-label={`Play: ${v.title}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
              </button>
              <span class="reel-len">{v.length}</span>
            </div>
            <figcaption>
              <span class="reel-no">0{i + 1}</span>
              <div>
                <strong>{v.title}</strong>
                <span>{v.note}</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="fp-photos">
        {sunCityPhotos.map((img) => (
          <a href={img.src} target="_blank" rel="noopener" style={`--col:${img.col}`} aria-label={`Open photo: ${img.alt}`}>
            <img src={img.src} width={img.w} height={img.h} alt={img.alt} loading="lazy" decoding="async" />
            <span>{img.caption}</span>
          </a>
        ))}
      </div>

      <div class="fp-foot">
        <p>Have a pharmacy or shop to fit out?</p>
        <a class="btn btn-red" href={commercialWhatsApp} target="_blank" rel="noopener noreferrer">Send us your drawings</a>
      </div>
    </div>
  </section>

  <!-- STANDARDS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How we work</span>
        <h2>Smart. Reliable. Professional.</h2>
      </div>
      <div class="std">
        {standards.map((s) => (
          <article>
            <span>{s.no}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section-alt" id="process">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>From first photo to final fit.</h2>
        <p class="muted">The same five steps for a single vanity or a full shop.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <b>{s.no}</b>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ESTIMATE -->
  <section class="section" id="estimate">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Quick estimate</span>
        <h2>Send the right details, get a faster quote.</h2>
        <p class="muted">Fill in what you know. It builds a WhatsApp message for you — nothing is sent until you press the button.</p>
      </div>

      <div class="est">
        <form class="est-form" id="estimateForm" novalidate>
          <div class="row-2">
            <div class="field">
              <label for="estName">Your name</label>
              <input class="input" id="estName" type="text" autocomplete="name" placeholder="e.g. Johan" />
            </div>
            <div class="field">
              <label for="estLocation">Suburb / town</label>
              <input class="input" id="estLocation" type="text" autocomplete="address-level2" placeholder="e.g. Montana, Pretoria" />
            </div>
          </div>

          <div class="field">
            <label for="estType">Project type</label>
            <select class="select" id="estType">
              <optgroup label="Residential">
                <option>Kitchen</option>
                <option>Built-in cupboards / wardrobe</option>
                <option>TV / wall unit</option>
                <option>Bathroom vanity</option>
                <option>Laundry / scullery</option>
                <option>Home office / storage</option>
              </optgroup>
              <optgroup label="Commercial">
                <option>Pharmacy fitout</option>
                <option>Retail / shop fitout</option>
                <option>Office / consulting rooms</option>
                <option>Coffee shop / kitchenette</option>
              </optgroup>
              <option>Other</option>
            </select>
          </div>

          <div class="row-3">
            <div class="field">
              <label for="estW">Width</label>
              <input class="input" id="estW" type="text" inputmode="numeric" placeholder="e.g. 3200 mm" />
            </div>
            <div class="field">
              <label for="estH">Height</label>
              <input class="input" id="estH" type="text" inputmode="numeric" placeholder="e.g. 2400 mm" />
            </div>
            <div class="field">
              <label for="estD">Depth</label>
              <input class="input" id="estD" type="text" inputmode="numeric" placeholder="e.g. 600 mm" />
            </div>
          </div>

          <div class="photo-drop">
            <label class="field-title" for="estPhotos">Photos of the space</label>
            <span class="hint">Show the full wall, corners, plugs, pipes, ceiling and floor. Drawings can be photographed too.</span>
            <input class="input" id="estPhotos" type="file" accept="image/*" multiple />
            <div class="thumbs" id="estThumbs"></div>
          </div>

          <fieldset class="field" style="border:0;padding:0;margin:0">
            <legend class="field-title" style="margin-bottom:8px">Things in the way (tick what applies)</legend>
            <div class="checks">
              {["Plugs / switches", "Water pipes", "Corners", "Bulkhead / low ceiling", "Skirting", "Uneven wall or floor", "Window", "Geyser / DB board"].map((v) => (
                <label class="chip"><input type="checkbox" name="siteDetails" value={v} /> {v}</label>
              ))}
            </div>
          </fieldset>

          <fieldset class="field" style="border:0;padding:0;margin:0">
            <legend class="field-title" style="margin-bottom:8px">Finish</legend>
            <div class="finishes">
              {finishes.map((f, i) => (
                <label class="finish">
                  <input type="radio" name="finish" value={f.value} checked={i === 0} />
                  <i style={`background:${f.swatch}`}></i>
                  <span><strong>{f.label}</strong><small>{f.note}</small></span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="field">
            <label for="estNotes">Anything else?</label>
            <textarea class="textarea" id="estNotes" placeholder="e.g. soft-close drawers, LED strip lights, match existing cupboards, need it before December"></textarea>
          </div>
        </form>

        <aside class="est-preview" aria-label="WhatsApp message preview">
          <h3 style="font-size:1.3rem">Your WhatsApp message</h3>
          <pre id="estPreview"></pre>
          <button class="btn btn-red" id="estSend" type="button">Send on WhatsApp</button>
          <p>On a phone, your photos are shared with the message — choose WhatsApp when asked. On a computer, WhatsApp opens with the text and you attach the photos there.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section section-alt" id="reviews">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Reviews</span>
        {reviews.length > 0 ? (
          <h2>What clients say.</h2>
        ) : (
          <h2>Worked with us? Leave a review.</h2>
        )}
        <p class="muted">Reviews are checked before they are published, to keep out spam.</p>
      </div>

      <div class={`rev ${reviews.length === 0 ? "empty" : ""}`}>
        {reviews.length > 0 && (
          <div class="rev-grid">
            {reviews.map((r) => (
              <article class="rev-card">
                <div class="s" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</div>
                <p>“{r.message}”</p>
                <footer><strong>{r.name}</strong> · {r.project}</footer>
              </article>
            ))}
          </div>
        )}

        <form class="rev-form" id="reviewForm">
          <h3>{reviews.length > 0 ? "Add your review" : "Your review"}</h3>
          <input name="company" id="revCompany" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0" />
          <div class="row-2">
            <div class="field">
              <label for="revName">Name</label>
              <input class="input" id="revName" type="text" maxlength="80" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="revProject">Project</label>
              <select class="select" id="revProject">
                <option>Kitchen</option>
                <option>Built-in cupboards</option>
                <option>TV unit</option>
                <option>Vanity</option>
                <option>Storage / other</option>
                <option>Commercial fitout</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="revRating">Rating</label>
            <select class="select" id="revRating">
              <option value="5">★★★★★ 5 – Excellent</option>
              <option value="4">★★★★☆ 4 – Good</option>
              <option value="3">★★★☆☆ 3 – Average</option>
              <option value="2">★★☆☆☆ 2 – Poor</option>
              <option value="1">★☆☆☆☆ 1 – Very poor</option>
            </select>
          </div>
          <div class="field">
            <label for="revMessage">Review</label>
            <textarea class="textarea" id="revMessage" maxlength="240" minlength="8" required></textarea>
            <span class="hint"><span id="revCount">0</span>/240</span>
          </div>
          <div class="rev-actions">
            <button class="btn btn-dark" type="submit" id="revSubmit">Submit review</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section-dark" id="contact">
    <div class="wrap contact-band">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>Send your space. We'll send a quote.</h2>
        <p class="lead">WhatsApp is fastest — photos, rough sizes or drawings, plus your suburb. Based in {SITE.locality}.</p>
      </div>
      <div class="contact-list">
        <a class="btn btn-red" href={DEFAULT_WHATSAPP} target="_blank" rel="noopener noreferrer"><span>WhatsApp</span><span>{SITE.displayPhone}</span></a>
        <a class="btn btn-line-light" href={`tel:${SITE.intlPhone.replace(/\s/g, "")}`}><span>Call</span><span>{SITE.displayPhone}</span></a>
        <a class="btn btn-line-light" href={mailLink("Quote request - WhichwoodFitters", "Hi WhichwoodFitters,\n\nI would like a quote.\n\nProject type:\nMeasurements / drawings:\nLocation:\n\nThank you.")}><span>Email</span><span>{SITE.email}</span></a>
      </div>
    </div>
  </section>

  <script slot="scripts" is:inline define:vars={{ whatsappNumber: SITE.whatsappNumber }}>
    (function () {
      var toast = function (m) { if (window.wwToast) window.wwToast(m); };
      var $ = function (id) { return document.getElementById(id); };
      var val = function (id) { var el = $(id); var v = el && el.value ? el.value.trim() : ""; return v; };

      /* ---------- Estimate builder ---------- */
      var form = $("estimateForm");
      var photos = $("estPhotos");
      var thumbs = $("estThumbs");
      var preview = $("estPreview");
      var urls = [];

      function files() { return Array.prototype.slice.call((photos && photos.files) || []); }

      function renderThumbs() {
        urls.forEach(function (u) { URL.revokeObjectURL(u); });
        urls = [];
        thumbs.replaceChildren();
        files().forEach(function (f, i) {
          var u = URL.createObjectURL(f);
          urls.push(u);
          var img = document.createElement("img");
          img.src = u;
          img.alt = "Selected photo " + (i + 1);
          thumbs.appendChild(img);
        });
      }

      function build() {
        var lines = ["Hi WhichwoodFitters, I'd like a quote."];
        var name = val("estName");
        var loc = val("estLocation");
        lines.push("");
        if (name) lines.push("Name: " + name);
        lines.push("Location: " + (loc || "(not given)"));
        lines.push("Project: " + val("estType"));

        var w = val("estW"), h = val("estH"), d = val("estD");
        if (w || h || d) {
          lines.push("");
          lines.push("Sizes: W " + (w || "?") + " × H " + (h || "?") + " × D " + (d || "?"));
        }

        var checks = Array.prototype.map.call(document.querySelectorAll('input[name="siteDetails"]:checked'), function (c) { return c.value; });
        if (checks.length) lines.push("On site: " + checks.join(", "));

        var finish = document.querySelector('input[name="finish"]:checked');
        lines.push("Finish: " + (finish ? finish.value : "Not sure yet"));

        var n = files().length;
        lines.push("Photos: " + (n ? n + " attached" : "will send"));

        var notes = val("estNotes");
        if (notes) { lines.push(""); lines.push("Notes: " + notes); }

        var msg = lines.join("\n");
        if (preview) preview.textContent = msg;
        return msg;
      }

      async function send() {
        var msg = build();
        var f = files();
        if (f.length && navigator.canShare && navigator.share) {
          try {
            if (navigator.canShare({ files: f })) {
              await navigator.share({ text: msg, files: f });
              return;
            }
          } catch (e) {
            if (e && e.name === "AbortError") return; // user cancelled the share sheet
          }
        }
        window.open("https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(msg), "_blank", "noopener,noreferrer");
        if (f.length) toast("WhatsApp opened — attach your photos in the chat.");
      }

      if (form) {
        form.addEventListener("input", build);
        form.addEventListener("change", build);
        photos && photos.addEventListener("change", function () { renderThumbs(); build(); });
        $("estSend").addEventListener("click", send);
        build();
      }
      window.addEventListener("pagehide", function () { urls.forEach(function (u) { URL.revokeObjectURL(u); }); });


      /* ---------- Project videos ---------- */
      var reels = Array.prototype.slice.call(document.querySelectorAll(".reel"));
      reels.forEach(function (reel) {
        var v = reel.querySelector("video");
        var btn = reel.querySelector(".reel-play");
        function start() {
          reels.forEach(function (o) { if (o !== reel) { var ov = o.querySelector("video"); ov.pause(); } });
          v.controls = true;
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        }
        btn.addEventListener("click", start);
        v.addEventListener("play", function () { reel.classList.add("playing"); });
        v.addEventListener("pause", function () { if (!v.seeking) reel.classList.remove("playing"); });
        v.addEventListener("ended", function () { reel.classList.remove("playing"); v.controls = false; v.currentTime = 0; v.load(); });
      });

      /* ---------- Review form ---------- */
      var rf = $("reviewForm");
      var msgEl = $("revMessage");
      var count = $("revCount");
      msgEl && msgEl.addEventListener("input", function () { count.textContent = String(msgEl.value.length); });

      rf && rf.addEventListener("submit", async function (e) {
        e.preventDefault();
        var name = val("revName");
        var message = val("revMessage");
        if (!name) { toast("Please add your name."); $("revName").focus(); return; }
        if (message.length < 8) { toast("Please write a slightly longer review."); msgEl.focus(); return; }

        var btn = $("revSubmit");
        btn.disabled = true;
        btn.textContent = "Sending…";
        try {
          var res = await fetch("/api/testimonials", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              name: name,
              project: val("revProject"),
              rating: val("revRating"),
              message: message,
              company: val("revCompany")
            })
          });
          if (!res.ok) throw new Error();
          rf.reset();
          count.textContent = "0";
          toast("Thank you — your review will appear once approved.");
        } catch (err) {
          toast("Could not send right now. Please WhatsApp your review instead.");
        } finally {
          btn.disabled = false;
          btn.textContent = "Submit review";
        }
      });
    })();
  </script>
</Site>
