---

<Site
  title="Styles & Finishes Gallery | WhichwoodFitters, Pretoria"
  description="Kitchen, built-in cupboard, TV unit, vanity and storage styles and finishes that WhichwoodFitters builds. Pick a look and send it to us for a quote."
  path="/gallery"
  ogImage="/images/kitchens/kitchen-02.jpg"
>
  <style>
    .g-hero { padding: clamp(40px, 6vw, 72px) 0 32px; }
    .g-hero p { margin-top: 18px; max-width: 40em; font-size: 1.1rem; color: var(--ink-2); }
    .g-tabs { position: sticky; top: 72px; z-index: 20; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--line); }
    .g-tabs .wrap { display: flex; gap: 8px; overflow-x: auto; padding: 12px 0; scrollbar-width: none; }
    .g-tabs a { flex: none; padding: 9px 16px; border: 1px solid #cfccc6; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: .9rem; }
    .g-tabs a:hover { border-color: var(--ink); }
    .g-section { padding: 56px 0 8px; scroll-margin-top: 140px; }
    .g-section header { max-width: 720px; margin-bottom: 24px; }
    .g-section header p { color: var(--muted); margin-top: 10px; }
    .g-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .g-card { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #fff; display: flex; flex-direction: column; }
    .g-card button.img { all: unset; cursor: zoom-in; display: block; }
    .g-card img { width: 100%; aspect-ratio: 5 / 3; object-fit: cover; }
    .g-card .body { padding: 16px 18px 18px; display: grid; gap: 6px; flex: 1; }
    .g-card h3 { font-size: 1.05rem; font-family: var(--sans); font-weight: 700; }
    .g-card p { color: var(--muted); font-size: .92rem; }
    .g-card .ask { margin-top: auto; padding-top: 8px; background: none; border: 0; font: 600 .92rem var(--sans); color: var(--red); cursor: pointer; text-align: left; padding-left: 0; }
    .g-card .ask:hover { text-decoration: underline; }
    @media (max-width: 960px) { .g-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .g-grid { grid-template-columns: 1fr; } }

    .g-cta { margin-top: 72px; }
    .g-cta .wrap { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
    .g-cta p { color: #cfcfcf; margin-top: 12px; }

    dialog.lb { width: min(100% - 24px, 1400px); max-height: calc(100% - 24px); padding: 0; border: 0; border-radius: var(--radius); background: #fff; }
    dialog.lb::backdrop { background: rgba(0,0,0,.82); }
    .lb img { width: 100%; max-height: 78vh; object-fit: contain; background: #111; }
    .lb .lb-body { padding: 18px 22px 22px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; }
    .lb .lb-body p { color: var(--muted); margin-top: 4px; }
    .lb .lb-actions { display: flex; gap: 10px; }
  </style>

  <section class="g-hero">
    <div class="wrap">
      <span class="eyebrow">Gallery</span>
      <h1>Styles & finishes we build.</h1>
      <p>Use these as a starting point. See a look you like? Tap <strong>“Ask about this”</strong> and it goes to us on WhatsApp with the picture — then send photos of your own space and we'll quote it to fit.</p>
    </div>
  </section>

  <nav class="g-tabs" aria-label="Gallery sections">
    <div class="wrap">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </div>
  </nav>

  {sections.map((section) => (
    <section class="g-section" id={section.id}>
      <div class="wrap">
        <header>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
        </header>
        <div class="g-grid">
          {section.items.map((item) => (
            <article class="g-card">
              <button class="img" type="button" data-lb={item.image.replace(/\/([^/]+)$/, "/full/$1")} data-title={item.title} data-text={item.text} aria-label={`View larger: ${item.title}`}>
                <img src={item.image} alt={item.title} width="1200" height="720" loading="lazy" decoding="async" />
              </button>
              <div class="body">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <button class="ask" type="button" data-ask={item.image} data-title={item.title}>Ask about this →</button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section section-dark g-cta">
    <div class="wrap">
      <div>
        <h2>Have your own idea?</h2>
        <p>Send a screenshot, photos of your space and rough sizes. Based in {SITE.locality}.</p>
      </div>
      <a class="btn btn-red" href={galleryWhatsApp} target="_blank" rel="noopener noreferrer">WhatsApp {SITE.displayPhone}</a>
    </div>
  </section>

  <dialog class="lb" id="lightbox" aria-label="Image preview">
    <img id="lbImg" src="" alt="" />
    <div class="lb-body">
      <div>
        <h3 id="lbTitle"></h3>
        <p id="lbText"></p>
      </div>
      <div class="lb-actions">
        <button class="btn btn-red" type="button" id="lbAsk">Ask about this</button>
        <button class="btn btn-line" type="button" id="lbClose">Close</button>
      </div>
    </div>
  </dialog>

  <script slot="scripts" is:inline define:vars={{ whatsappNumber: SITE.whatsappNumber }}>
    (function () {
      var dlg = document.getElementById("lightbox");
      var img = document.getElementById("lbImg");
      var current = null;

      function message(title, image) {
        var url = new URL(image, location.origin).href;
        return "Hi WhichwoodFitters, I like this style from your gallery and would like a quote for something similar.\n\n" +
          "Style: " + title + "\nPicture: " + url + "\n\nMy suburb:\nRough sizes:\n(I'll send photos of my space)";
      }

      async function ask(title, image) {
        var msg = message(title, image);
        try {
          if (navigator.share && navigator.canShare) {
            var res = await fetch(image, { cache: "force-cache" });
            var blob = await res.blob();
            var file = new File([blob], title.toLowerCase().replace(/[^a-z0-9]+/g, "-") + ".jpg", { type: blob.type || "image/jpeg" });
            if (navigator.canShare({ files: [file] })) {
              await navigator.share({ text: msg, files: [file] });
              return;
            }
          }
        } catch (e) {
          if (e && e.name === "AbortError") return;
        }
        window.open("https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(msg), "_blank", "noopener,noreferrer");
      }

      document.querySelectorAll("[data-lb]").forEach(function (b) {
        b.addEventListener("click", function () {
          current = { title: b.dataset.title, image: b.dataset.lb };
          img.src = b.dataset.lb;
          img.alt = b.dataset.title;
          document.getElementById("lbTitle").textContent = b.dataset.title;
          document.getElementById("lbText").textContent = b.dataset.text;
          dlg.showModal();
        });
      });
      document.querySelectorAll("[data-ask]").forEach(function (b) {
        b.addEventListener("click", function () { ask(b.dataset.title, b.dataset.ask); });
      });
      document.getElementById("lbAsk").addEventListener("click", function () { if (current) ask(current.title, current.image); });
      document.getElementById("lbClose").addEventListener("click", function () { dlg.close(); });
      dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener("close", function () { img.src = ""; current = null; });
    })();
  </script>
</Site>
