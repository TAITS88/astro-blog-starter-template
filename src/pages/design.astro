    }

    function rebuild() {
      if (!renderer) return;
      root.traverse(o => { const m = o as THREE.Mesh; if (m.geometry) m.geometry.dispose(); });
      root.clear(); labelsEl.replaceChildren(); labs = [];
      const pr = P[st.p], L = st.L, X0 = -L / 2;
      let maxTop = pr.up.y0 + pr.up.h;
      // room
      const wallH = Math.max(2400, maxTop + 200);
      box(L, wallH, 20, 0, wallH / 2, -10, std(0xe4e0d9, .9), false);
      const fl = new THREE.Mesh(new THREE.PlaneGeometry(mm(L) + 3, 4), std(0xd2ccc3, .85)); fl.rotation.x = -Math.PI / 2; fl.position.set(0, 0, 1.6); fl.receiveShadow = true; root.add(fl);
      for (const s of [-1, 1]) box(60, wallH, 900, s * (L / 2 + 30), wallH / 2, 440, std(0xd9d4cc, .9), false);
      // wall length dimension
      label(`Wall ${L} mm`, 0, 0, (pr.floor.d || 600) + 420);

      const placeRow = (row: U[], r: Row, isFloor: boolean) => {
        let x = X0; const tops: [number, number][] = [];
        row.forEach(([t, w]) => {
          const ut = T[t]; const h = ut.h || r.h; const y0 = r.y0, d = r.d, fz = d + 9;
          const over = x + w > L / 2 + 1;
          if (t === "space") {
            if (isFloor) { const o = box(w - 6, 4, d - 40, x + w / 2, 2, d / 2, std(0xbcb5aa, .9), false); o.castShadow = false; }
          } else {
            if (ut.carcass !== false) {
              if (ut.front === "open") {
                box(16, h, d, x + 8, y0 + h / 2, d / 2, carcassM()); box(16, h, d, x + w - 8, y0 + h / 2, d / 2, carcassM());
                box(w - 32, 16, d, x + w / 2, y0 + 8, d / 2, carcassM()); box(w - 32, 16, d, x + w / 2, y0 + h - 8, d / 2, carcassM());
                box(w - 32, 16, d - 20, x + w / 2, y0 + h / 2, d / 2 - 10, carcassM());
                box(w - 32, h - 32, 6, x + w / 2, y0 + h / 2, 3, carcassM(), false);
              } else box(w, h, d, x + w / 2, y0 + h / 2, d / 2, carcassM());
            }
            for (const pc of fronts(ut.front, w, h)) {
              const cx = x + pc.x + pc.w / 2, cy = y0 + pc.y + pc.h / 2;
              const m = pc.kind === "glass" ? glass() : pc.kind === "mirror" ? std(0xdfe6ea, .05, 1) : doorM(pc.kind === "drawer");
              box(pc.w, pc.h, 18, cx, cy, fz, m);
              if (pc.kind === "glass") { box(pc.w, 60, 20, cx, y0 + pc.y + pc.h - 30, fz + 1, steel(), false); handle(cx, y0 + pc.y + pc.h - 110, fz + 9, Math.min(460, pc.w - 80), false); continue; }
              const hl = st.h === "none" ? 0 : 1;
              if (!hl) continue;
              if (pc.kind === "drawer") {
                const len = Math.min(pc.w * .5, 320);
                handle(cx, pc.side === -1 ? y0 + pc.y + 50 : y0 + pc.y + pc.h - Math.min(45, pc.h / 3), fz + 9, len, false);
              } else {
                const hx = x + pc.x + (pc.side! > 0 ? pc.w - 40 : 40);
                const isTall = pc.h > 1100;
                const hy = isTall ? Math.min(y0 + pc.y + pc.h - 200, 1100) : isFloor && st.p !== "vanity" ? y0 + pc.y + pc.h - 130 : y0 + pc.y + 130;
                handle(hx, isFloor && st.p === "vanity" ? y0 + pc.y + pc.h - 110 : hy, fz + 9, isTall ? 500 : 200, true);
              }
            }
            // extras
            const cx = x + w / 2, topY = y0 + h + pr.topT;
            if (ut.extra === "fridge") {
              const fh = 1850; box(w - 20, fh, 640, cx, fh / 2, 330, std(0xbfc3c8, .3, .6));
              box(w - 22, 4, 4, cx, 1150, 652, std(0x6f7378, .4, .6), false);
              handle(x + w - 70, 1300, 650, 400, true); handle(x + w - 70, 700, 650, 300, true);
            }
            if (ut.extra === "sink") {
              const sw = Math.min(w - 150, 760);
              box(sw, 4, 440, cx, topY + 2, 300, steel(), false); box(sw - 60, 3, 380, cx, topY + 3, 300, std(0x6f7378, .35, .9), false);
              const tp = new THREE.Mesh(new THREE.CylinderGeometry(.012, .016, .28, 14), steel()); tp.position.set(mm(cx), mm(topY) + .14, .09); root.add(tp);
              const sp = new THREE.Mesh(new THREE.TorusGeometry(.08, .011, 10, 24, Math.PI), steel()); sp.position.set(mm(cx), mm(topY) + .28, .17); sp.rotation.y = Math.PI / 2; root.add(sp);
            }
            if (ut.extra === "hob") {
              box(590, 6, 520, cx, topY + 3, 300, glass(), false);
              for (const [rx, rz, rr] of [[-140, -120, 80], [140, -120, 65], [-140, 120, 65], [140, 120, 90]]) {
                const ring = new THREE.Mesh(new THREE.RingGeometry(mm(rr - 8), mm(rr), 32), std(0x555555, .4)); ring.rotation.x = -Math.PI / 2;
                ring.position.set(mm(cx + rx), mm(topY + 6.5), mm(300 + rz)); root.add(ring);
              }
            }
            if (ut.extra === "hood") {
              box(w, 60, 480, cx, y0 + 100, 250, steel(), false);
              const chTop = Math.max(y0 + h + 200, 2350); box(260, chTop - y0 - 130, 220, cx, (chTop + y0 + 130) / 2, 120, steel(), false);
            }
            if (ut.extra === "shelf") box(w, 32, d - 50, cx, y0 + (isFloor ? 0 : h / 2), (d - 50) / 2, doorM(true));
            if (ut.extra === "mirror") box(w, h, 6, cx, y0 + h / 2, 6, std(0xdfe6ea, .05, 1));
            if (ut.extra === "basin" || ut.extra === "basin2") {
              const n = ut.extra === "basin2" ? 2 : 1;
              for (let i = 0; i < n; i++) {
                const bx = x + (w / (n * 2)) * (2 * i + 1);
                box(460, 130, 360, bx, topY + 65, 240, ceramic(), false);
                const tp = new THREE.Mesh(new THREE.CylinderGeometry(.01, .014, .22, 12), steel()); tp.position.set(mm(bx), mm(topY) + .11, .05); root.add(tp);
              }
            }
            if (ut.top) tops.push([x, x + w]);
          }
          label(String(w), x + w / 2, isFloor ? y0 - (pr.plinthH ? pr.plinthH / 2 : 60) : y0 + h + 60, isFloor ? d + 30 : d + 20, !isFloor);
          if (over) label("too long", x + w / 2, y0 + (ut.h || r.h) / 2, d + 40);
          x += w;
        });
        // worktop segments + plinth
        if (isFloor) {
          if (pr.worktop) {
            const segs: [number, number][] = [];
            for (const s of tops) { const l = segs[segs.length - 1]; if (l && Math.abs(l[1] - s[0]) < 1) l[1] = s[1]; else segs.push([...s]); }
            for (const [a, b] of segs) box(b - a, pr.topT, pr.topD, (a + b) / 2, r.y0 + r.h + pr.topT / 2, pr.topD / 2, topM());
          }
          if (pr.plinthH) {
            let px = X0;
            row.forEach(([t, w]) => { if (T[t].plinth) box(w, pr.plinthH, 16, px + w / 2, pr.plinthH / 2, r.d - 60, std(0x1c1c1c, .7), false); px += w; });
          }
