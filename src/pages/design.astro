        return { p: x.p, L, f: row(x.f, pr.fTypes), u: row(x.u, pr.uTypes), d: DOORS[x.d] ? x.d : "white", k: TOPS[x.k] ? x.k : "quartz", h: HANDLES[x.h] ? x.h : "black" };
