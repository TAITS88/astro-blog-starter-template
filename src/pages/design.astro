      placeRow(st.f, pr.floor, true);
      placeRow(st.u, pr.up, false);
      if (st.p === "tv") { box(1230, 710, 30, 0, 1150, 40, glass(), false); box(1210, 690, 2, 0, 1150, 56, std(0x1b2430, .2, .2), false); }
      setLabelsPos();
    }

    // camera
    let yaw = .32, pitch = .16, zoom = 1, W = 1, H = 1;
    const tgt = new THREE.Vector3();
    function fitView(resetAngles = false) { if (resetAngles) { yaw = .32; pitch = .16; zoom = 1; } }
    function placeCam() {
      const pr = P[st.p], top = Math.max(pr.up.y0 + pr.up.h, pr.floor.y0 + Math.max(...st.f.map(u => T[u[0]].h || pr.floor.h), pr.floor.h)) + 150;
      const spanW = Math.max(st.L, used(st.f), used(st.u)) + 500;
      tgt.set(0, mm(top) / 2, .35);
      const t = Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2);
      const dist = Math.max(mm(top + 300) / 2 / t, mm(spanW) / 2 / (t * camera.aspect)) * 1.08 / zoom + .4;
      camera.position.set(tgt.x + Math.sin(yaw) * Math.cos(pitch) * dist, tgt.y + Math.sin(pitch) * dist, tgt.z + Math.cos(yaw) * Math.cos(pitch) * dist);
      camera.lookAt(tgt);
    }
    const v = new THREE.Vector3();
    function setLabelsPos() {
      for (const l of labs) {
        v.copy(l.p).project(camera);
        const vis = v.z < 1 && Math.abs(v.x) < 1.05 && Math.abs(v.y) < 1.05;
        l.el.style.display = vis ? "" : "none";
        l.el.style.left = `${(v.x * .5 + .5) * W}px`; l.el.style.top = `${(-v.y * .5 + .5) * H}px`;
      }
    }
    if (renderer) {
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace; renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.setClearColor(0xefece7);
      stage.prepend(renderer.domElement);
      scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), .04).texture;
      const key = new THREE.DirectionalLight(0xffffff, 1.3); key.position.set(2.5, 5, 5); key.castShadow = true;
      key.shadow.mapSize.set(2048, 2048); Object.assign(key.shadow.camera, { left: -5, right: 5, top: 4, bottom: -2, near: .5, far: 20 }); key.shadow.radius = 4; key.shadow.bias = -.0004;
      scene.add(key, new THREE.HemisphereLight(0xffffff, 0xb9b2a8, .45));
      const resize = () => { W = stage.clientWidth; H = stage.clientHeight; renderer!.setSize(W, H, false); camera.aspect = W / H; camera.updateProjectionMatrix(); };
      const ro = new ResizeObserver(resize); ro.observe(stage); resize();
      let drag = false, lx = 0, ly = 0;
      stage.addEventListener("pointerdown", e => { if ((e.target as HTMLElement).closest("button")) return; drag = true; lx = e.clientX; ly = e.clientY; stage.setPointerCapture(e.pointerId); });
      stage.addEventListener("pointermove", e => { if (!drag) return; yaw -= (e.clientX - lx) * .006; pitch = Math.max(-.05, Math.min(.9, pitch + (e.clientY - ly) * .004)); lx = e.clientX; ly = e.clientY; });
      const end = () => { drag = false; }; stage.addEventListener("pointerup", end); stage.addEventListener("pointercancel", end);
      $("dzZoomIn").addEventListener("click", () => { zoom = Math.min(2.5, zoom * 1.2); });
      $("dzZoomOut").addEventListener("click", () => { zoom = Math.max(.6, zoom / 1.2); });
      $("dzFront").addEventListener("click", () => { yaw = 0; pitch = .08; zoom = 1; });
      let visible = true; const io = new IntersectionObserver(es => { visible = es[0].isIntersecting; }); io.observe(stage);
      const loop = () => { requestAnimationFrame(loop); if (!visible || document.hidden) return; placeCam(); setLabelsPos(); renderer!.render(scene, camera); };
      requestAnimationFrame(loop);
    }
    renderUI(); rebuild();
  </script>
