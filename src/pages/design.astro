    }
    function addUnit(row: "f" | "u", t: string) {
      const free = st.L - used(st[row]); const ut = T[t];
      let w = ut.def <= free ? ut.def : [...ut.widths].reverse().find(x => x <= free);
      if (!w) { toast(`No room left on this row (${Math.max(0, free)} mm free). Make the wall longer or a unit narrower.`); return; }
      change(() => { st[row].push([t, w!]); });
    }
    function list(row: "f" | "u", host: string) {
      const ol = $(host); ol.replaceChildren();
      st[row].forEach((u, i) => {
        const li = el("li", "dz-item"); const ut = T[u[0]];
        const name = el("span", "", ut.label);
        const sel = el("select", "select") as HTMLSelectElement; sel.setAttribute("aria-label", `${ut.label} width`);
        for (const w of ut.widths) { const o = el("option", "", `${w} mm`) as HTMLOptionElement; o.value = String(w); o.selected = w === u[1]; sel.append(o); }
        sel.addEventListener("change", () => change(() => { st[row][i][1] = Number(sel.value); }));
