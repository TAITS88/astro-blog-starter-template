        if (key === "d" && v.g !== grp) { grp = v.g; const t = el("span", "dz-grp", grp === "solid" ? "PG Bison MelaWood · solid colours" : grp === "wood" ? "PG Bison MelaWood · woodgrains" : "Other"); h.append(t); }
        const b = el("button", "dz-swb") as HTMLButtonElement; b.type = "button"; b.setAttribute("aria-pressed", String(st[key] === k));
