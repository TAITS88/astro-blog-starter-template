        const left = mk("←", "Move left", () => change(() => { const a = st[row]; [a[i - 1], a[i]] = [a[i], a[i - 1]]; }), i === 0, "dz-ib dz-left");
        const right = mk("→", "Move right", () => change(() => { const a = st[row]; [a[i + 1], a[i]] = [a[i], a[i + 1]]; }), i === st[row].length - 1);
        const del = mk("✕", `Remove ${ut.label}`, () => change(() => { st[row].splice(i, 1); }));
        li.append(name, sel, left, right, del); ol.append(li);
      });
    }
    function meter(row: U[], fill: string, txt: string) {
      const u = used(row), f = $(fill), t = $(txt), over = u > st.L;
      f.style.width = `${Math.min(100, u / st.L * 100)}%`; f.classList.toggle("over", over);
      t.textContent = over ? `${u - st.L} mm too long` : `${u} of ${st.L} mm · ${st.L - u} free`;
      t.classList.toggle("over", over);
    }
    function renderUI() {
      const pr = P[st.p];
      document.querySelectorAll<HTMLButtonElement>(".dz-tab").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.p === st.p)));
      ($("dzLen") as HTMLInputElement).value = String(st.L);
      $("dzFloorTitle").textContent = pr.fTitle; $("dzUpTitle").textContent = pr.uTitle;
      $("dzFloorHelp").textContent = pr.fHelp; $("dzUpHelp").textContent = pr.uHelp;
      $("dzMeterFloorL").textContent = pr.fTitle; $("dzMeterUpL").textContent = pr.uTitle;
      for (const [row, host] of [["f", "dzPalFloor"], ["u", "dzPalUp"]] as const) {
        const h = $(host); h.replaceChildren();
        for (const t of row === "f" ? pr.fTypes : pr.uTypes) { const b = el("button", "dz-add", T[t].label) as HTMLButtonElement; b.type = "button"; b.addEventListener("click", () => addUnit(row, t)); h.append(b); }
      }
      list("f", "dzListFloor"); list("u", "dzListUp");
      swatches("dzDoors", DOORS, "d"); swatches("dzHandles", HANDLES, "h");
      $("dzTopTitle").hidden = !pr.worktop; $("dzTops").hidden = !pr.worktop;
      $("dzTopTitle").textContent = st.p === "vanity" ? "Vanity top" : "Worktop";
      if (pr.worktop) swatches("dzTops", TOPS, "k");
      meter(st.f, "dzFillFloor", "dzTxtFloor"); meter(st.u, "dzFillUp", "dzTxtUp");
      ($("dzUndo") as HTMLButtonElement).disabled = !undo.length;
      ($("dzEmail") as HTMLAnchorElement).href = `mailto:${SITE.email}?subject=${encodeURIComponent(`My ${P[st.p].label.toLowerCase()} design`)}&body=${encodeURIComponent(message())}`;
    }
    const lenIn = $("dzLen") as HTMLInputElement;
    const setLen = (v: number) => { v = Math.round(Math.max(600, Math.min(8000, v)) / 10) * 10; if (v !== st.L) { change(() => { st.L = v; }); fitView(); } else lenIn.value = String(st.L); };
    lenIn.addEventListener("change", () => setLen(Number(lenIn.value) || st.L));
    $("dzLenMinus").addEventListener("click", () => setLen(st.L - 100));
    $("dzLenPlus").addEventListener("click", () => setLen(st.L + 100));
    $("dzUndo").addEventListener("click", () => { const s = undo.pop(); if (s) { st = JSON.parse(s); commit(); } });
    $("dzReset").addEventListener("click", () => { change(() => { st = presetOf(st.p); }); fitView(true); toast("Back to the starting layout"); });

    function message() {
      const pr = P[st.p], name = ($("dzName") as HTMLInputElement).value.trim(), area = ($("dzArea") as HTMLInputElement).value.trim(), notes = ($("dzNotes") as HTMLTextAreaElement).value.trim();
      const rows = (r: U[]) => r.length ? r.map((u, i) => `${i + 1}. ${T[u[0]].label} ${u[1]}`).join("\n") : "(none)";
      const L = [
        `Hi WhichwoodFitters, I designed a ${pr.label.toLowerCase()} on your website.`, "",
        `Name: ${name || "-"}`, `Area: ${area || "-"}`, `Wall length: ${st.L} mm`, "",
        `${pr.fTitle} (left to right, ${used(st.f)} mm):`, rows(st.f), "",
        `${pr.uTitle} (left to right, ${used(st.u)} mm):`, rows(st.u), "",
        `Doors: ${st.d === "sprayed" ? "Sprayed / painted" : `PG Bison ${DOORS[st.d].label}`}`,
        ...(pr.worktop ? [`${st.p === "vanity" ? "Top" : "Worktop"}: ${TOPS[st.k].label}`] : []),
        `Handles: ${HANDLES[st.h].label}`,
        ...(notes ? ["", `Notes: ${notes}`] : []),
        "", `Open my design in 3D: ${link()}`,
      ];
      return L.join("\n");
    }
    $("dzSend").addEventListener("click", () => {
      const n = $("dzName") as HTMLInputElement;
      if (!n.value.trim()) { toast("Add your name so we know who the design is from"); n.focus(); return; }
      if (!st.f.length && !st.u.length) { toast("Add at least one unit first"); return; }
      window.open(`https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(message())}`, "_blank", "noopener");
    });
    for (const id of ["dzName", "dzArea", "dzNotes"]) $(id).addEventListener("input", () => { ($("dzEmail") as HTMLAnchorElement).href = `mailto:${SITE.email}?subject=${encodeURIComponent(`My ${P[st.p].label.toLowerCase()} design`)}&body=${encodeURIComponent(message())}`; });
    $("dzCopy").addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(link()); toast("Design link copied"); }
      catch { prompt("Copy this link:", link()); }
    });

    // ================= 3D =================
    const stage = $("dzStage"), labelsEl = $("dzLabels");
    let renderer: THREE.WebGLRenderer | null = null;
    try { renderer = new THREE.WebGLRenderer({ antialias: true }); } catch { stage.append(el("p", "dz-note", "Your browser can't show the 3D preview, but you can still build and send your design.")); }
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, .05, 60);
    const root = new THREE.Group(); scene.add(root);
    type Lab = { el: HTMLElement; p: THREE.Vector3 };
    let labs: Lab[] = [];
    const texCache: Record<string, THREE.Texture> = {};
    function wood(base: string, horizontal: boolean) {
      const k = base + horizontal; if (texCache[k]) return texCache[k];
      const c = document.createElement("canvas"); c.width = 256; c.height = 1024; const g = c.getContext("2d")!;
      g.fillStyle = base; g.fillRect(0, 0, 256, 1024);
      let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
      for (let i = 0; i < 150; i++) {
        const x0 = rnd() * 256, amp = 2 + rnd() * 6, f = .004 + rnd() * .01, ph = rnd() * 6;
        g.strokeStyle = rnd() < .6 ? `rgba(60,35,18,${.05 + rnd() * .16})` : `rgba(240,210,165,${.05 + rnd() * .1})`;
        g.lineWidth = .6 + rnd() * 2.4; g.beginPath();
        for (let y = 0; y <= 1024; y += 16) g.lineTo(x0 + Math.sin(y * f + ph) * amp, y);
        g.stroke();
      }
      const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 4;
      if (horizontal) { t.center.set(.5, .5); t.rotation = Math.PI / 2; }
      return texCache[k] = t;
    }
    const matCache: Record<string, THREE.Material> = {};
    const mat = (key: string, make: () => THREE.Material) => matCache[key] || (matCache[key] = make());
    const std = (c: number, r = .5, m = 0) => mat(`s${c}-${r}-${m}`, () => new THREE.MeshStandardMaterial({ color: c, roughness: r, metalness: m }));
    const carcassM = () => std(0xeeebe5, .55);
    const doorM = (horizontal = false) => { const d = DOORS[st.d]; return d.wood ? mat(`dw${st.d}${horizontal}`, () => new THREE.MeshStandardMaterial({ map: wood(d.wood!, horizontal), roughness: .5 })) : std(d.c, .45); };
    const topM = () => { const t = TOPS[st.k]; return t.wood ? mat(`tw${st.k}`, () => new THREE.MeshStandardMaterial({ map: wood(t.wood!, true), roughness: .5 })) : std(t.c, t.r); };
    const steel = () => std(0xc9ccd0, .25, .9), glass = () => std(0x0b0b0c, .08, .3), ceramic = () => std(0xfafafa, .15);
    const edgeM = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity: .18 });
    const mm = (v: number) => v / 1000;
    function box(w: number, h: number, d: number, x: number, y: number, z: number, m: THREE.Material, edges = true, parent: THREE.Object3D = root) {
      const geo = new THREE.BoxGeometry(mm(w), mm(h), mm(d)); const o = new THREE.Mesh(geo, m);
      o.position.set(mm(x), mm(y), mm(z)); o.castShadow = o.receiveShadow = true;
