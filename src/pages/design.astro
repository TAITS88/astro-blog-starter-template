---
import Site from "../layouts/Site.astro";
export const prerender = true;
---

<Site
  title="Design your own kitchen or cupboard in 3D | WhichwoodFitters"
  description="Plan your kitchen, built-in cupboard, vanity or TV unit in 3D: set your wall length, add units, pick door colours, worktop and handles, then send the design to WhichwoodFitters on WhatsApp for a quote."
  path="/design"
>
  <style is:global>
    .dz { padding: clamp(28px, 4vw, 56px) 0 clamp(56px, 7vw, 96px); }
    .dz-head { max-width: 760px; margin-bottom: 24px; }
    .dz-head h1 { font-size: clamp(2rem, 4.2vw, 3.1rem); }
    .dz-head p { margin-top: 12px; font-size: 1.06rem; }
    .dz-shared { margin: 0 0 16px; padding: 12px 16px; border-left: 4px solid var(--red); background: var(--paper-2); font-weight: 500; }
    .dz-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
    .dz-view { position: sticky; top: 88px; display: grid; gap: 12px; }
    .dz-stage { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: #efece7; touch-action: pan-y; cursor: grab; border: 1px solid var(--line); }
    .dz-stage:active { cursor: grabbing; }
    .dz-stage canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; }
    .dz-labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .dz-lab { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); font: 600 11px/1 var(--sans); color: #fff; background: rgba(17,17,17,.78); padding: 3px 6px; border-radius: 3px; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .dz-lab.up { background: rgba(200,16,46,.85); }
    .dz-tools { position: absolute; top: 10px; right: 10px; display: flex; gap: 6px; }
    .dz-tool { min-width: 40px; min-height: 40px; padding: 0 10px; border: 1px solid #cfccc6; background: rgba(255,255,255,.92); border-radius: var(--radius); font: 600 .85rem var(--sans); cursor: pointer; color: var(--ink); }
    .dz-tool:hover { border-color: var(--ink); }
    .dz-hint { position: absolute; left: 12px; bottom: 10px; font-size: .8rem; color: #6d6a65; pointer-events: none; }
    .dz-meters { display: grid; gap: 8px; }
    .dz-meter { display: grid; grid-template-columns: 9.5em minmax(0, 1fr) auto; gap: 10px; align-items: center; font-size: .88rem; }
    .dz-meter b { font-weight: 600; }
    .dz-track { height: 10px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 99px; overflow: hidden; }
    .dz-fill { height: 100%; width: 0; background: var(--ink); transition: width .2s, background .2s; }
    .dz-fill.over { background: var(--red); }
    .dz-meter span { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--muted); }
    .dz-meter span.over { color: var(--red); font-weight: 600; }

    .dz-panel { display: grid; gap: 22px; }
    .dz-step { border-top: 1px solid var(--line); padding-top: 18px; display: grid; gap: 12px; }
    .dz-step:first-child { border-top: 0; padding-top: 0; }
    .dz-step h2 { font-size: 1.25rem; display: flex; gap: 10px; align-items: baseline; }
    .dz-step h2 small { font: 700 .8rem var(--sans); color: var(--red); }
    .dz-step .muted { font-size: .9rem; }
    .dz-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
    .dz-tab { min-height: 48px; border: 1px solid #cfccc6; background: #fff; border-radius: var(--radius); font: 600 .92rem var(--sans); cursor: pointer; color: var(--ink); padding: 6px; }
    .dz-tab[aria-pressed="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
    .dz-len { display: flex; gap: 8px; align-items: center; }
    .dz-len .input { max-width: 150px; text-align: center; font-variant-numeric: tabular-nums; }
    .dz-len .dz-tool { min-height: 48px; min-width: 48px; font-size: 1.1rem; }
    .dz-pal { display: flex; flex-wrap: wrap; gap: 8px; }
    .dz-add { min-height: 44px; padding: 0 12px; border: 1px dashed #a9a59f; background: #fff; border-radius: var(--radius); font: 500 .88rem var(--sans); cursor: pointer; color: var(--ink); }
    .dz-add:hover { border-style: solid; border-color: var(--red); color: var(--red); }
    .dz-add::before { content: "+ "; font-weight: 700; color: var(--red); }
    .dz-list { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; counter-reset: u; }
    .dz-list:empty::after { content: "Nothing added yet — tap a unit above."; color: var(--muted); font-size: .9rem; }
    .dz-item { display: grid; grid-template-columns: 1.6em minmax(0, 1fr) 6.6em 40px 40px 40px; gap: 6px; align-items: center; padding: 4px 4px 4px 8px; background: var(--paper-2); border-radius: var(--radius); }
    .dz-item::before { counter-increment: u; content: counter(u); font: 700 .8rem var(--sans); color: var(--red); }
    .dz-item > span { font-weight: 500; font-size: .92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dz-item .select { min-height: 40px; padding: 6px 8px; font-size: .9rem; }
    .dz-ib { width: 40px; height: 40px; border: 1px solid #d6d3cd; background: #fff; border-radius: var(--radius); cursor: pointer; font: 600 .95rem var(--sans); color: var(--ink); }
    .dz-ib:hover { border-color: var(--ink); }
    .dz-ib:disabled { opacity: .35; cursor: default; }
    .dz-sw { display: flex; flex-wrap: wrap; gap: 8px; }
    .dz-swb { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px 0 6px; border: 1px solid #cfccc6; background: #fff; border-radius: 99px; cursor: pointer; font: 500 .86rem var(--sans); color: var(--ink); }
    .dz-swb i { width: 30px; height: 30px; border-radius: 50%; border: 1px solid rgba(0,0,0,.15); background-size: cover; }
    .dz-swb[aria-pressed="true"] { border-color: var(--ink); box-shadow: 0 0 0 2px var(--ink); }
    .dz-sub { font-weight: 600; font-size: .9rem; }
    .dz-grp { flex: 1 1 100%; font-size: .8rem; color: var(--muted); margin-top: 4px; }
    .dz-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .dz-actions .btn-red { flex: 1 1 100%; }
    .dz-small { display: flex; flex-wrap: wrap; gap: 8px; }
    .dz-small button { min-height: 44px; }
    .dz-note { font-size: .85rem; color: var(--muted); }
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 960px) {
      .dz-grid { grid-template-columns: minmax(0, 1fr); }
      .dz-view { position: static; }
      .dz-stage { aspect-ratio: 4 / 3.2; }
    }
    @media (max-width: 560px) {
      .dz-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .dz-item { grid-template-columns: 1.4em minmax(0, 1fr) 5.8em 40px 40px; }
      .dz-item .dz-left { display: none; }
      .row-2 { grid-template-columns: 1fr; }
      .dz-meter { grid-template-columns: 7.5em minmax(0, 1fr) auto; font-size: .82rem; }
    }
  </style>

  <section class="dz">
    <div class="wrap">
      <div class="dz-head">
        <span class="eyebrow">Design your own</span>
        <h1>Plan it in 3D, then send it to us.</h1>
        <p class="muted">Choose what you're building, set the wall length and add units left to right. Pick your doors, worktop and handles. When it looks right, send it on WhatsApp — we'll check it on site, measure properly and quote from your design.</p>
      </div>
      <p class="dz-shared" id="dzShared" hidden>You're viewing a shared design. Change anything you like and send it again.</p>

      <div class="dz-grid">
        <div class="dz-view">
          <div class="dz-stage" id="dzStage" role="img" aria-label="3D preview of your design">
            <div class="dz-labels" id="dzLabels"></div>
            <div class="dz-tools">
              <button class="dz-tool" type="button" id="dzZoomOut" aria-label="Zoom out">−</button>
              <button class="dz-tool" type="button" id="dzZoomIn" aria-label="Zoom in">+</button>
              <button class="dz-tool" type="button" id="dzFront">Front view</button>
            </div>
            <span class="dz-hint">Drag to look around</span>
          </div>
          <div class="dz-meters">
            <div class="dz-meter"><b id="dzMeterFloorL">Floor units</b><div class="dz-track"><div class="dz-fill" id="dzFillFloor"></div></div><span id="dzTxtFloor"></span></div>
            <div class="dz-meter"><b id="dzMeterUpL">Wall units</b><div class="dz-track"><div class="dz-fill" id="dzFillUp"></div></div><span id="dzTxtUp"></span></div>
          </div>
        </div>

        <div class="dz-panel">
          <div class="dz-step">
            <h2><small>1</small>What are you building?</h2>
            <div class="dz-tabs" id="dzTabs"></div>
          </div>

          <div class="dz-step">
            <h2><small>2</small>Wall length</h2>
            <p class="muted">Measure the wall the units go against, corner to corner, in millimetres.</p>
            <div class="dz-len">
              <button class="dz-tool" type="button" id="dzLenMinus" aria-label="100 mm shorter">−</button>
              <input class="input" id="dzLen" type="number" inputmode="numeric" min="600" max="8000" step="10" aria-label="Wall length in millimetres" />
              <button class="dz-tool" type="button" id="dzLenPlus" aria-label="100 mm longer">+</button>
              <span class="muted">mm</span>
            </div>
          </div>

          <div class="dz-step">
            <h2><small>3</small><span id="dzFloorTitle">Floor units</span></h2>
            <p class="muted" id="dzFloorHelp"></p>
            <div class="dz-pal" id="dzPalFloor"></div>
            <ol class="dz-list" id="dzListFloor"></ol>
          </div>

          <div class="dz-step">
            <h2><small>4</small><span id="dzUpTitle">Wall units</span></h2>
            <p class="muted" id="dzUpHelp"></p>
            <div class="dz-pal" id="dzPalUp"></div>
            <ol class="dz-list" id="dzListUp"></ol>
          </div>

          <div class="dz-step">
            <h2><small>5</small>Finishes</h2>
            <span class="dz-sub">Doors &amp; drawer fronts</span>
            <div class="dz-sw" id="dzDoors"></div>
            <p class="dz-note">Colours on screen are close matches to the real boards. We bring samples before anything is cut. Want another PG Bison colour or a sprayed finish? Pick the closest and name it in your notes.</p>
            <span class="dz-sub" id="dzTopTitle">Worktop</span>
            <div class="dz-sw" id="dzTops"></div>
            <span class="dz-sub">Handles</span>
            <div class="dz-sw" id="dzHandles"></div>
          </div>

          <div class="dz-step">
            <h2><small>6</small>Send it to us</h2>
            <div class="row-2">
              <div class="field"><label for="dzName">Your name</label><input class="input" id="dzName" type="text" autocomplete="name" placeholder="e.g. Johan" /></div>
              <div class="field"><label for="dzArea">Suburb / town</label><input class="input" id="dzArea" type="text" autocomplete="address-level2" placeholder="e.g. Montana, Pretoria" /></div>
            </div>
            <div class="field"><label for="dzNotes">Anything else? <span class="muted">(optional)</span></label>
              <textarea class="textarea" id="dzNotes" placeholder="e.g. ceiling height 2600, fridge is 900 wide, window above the sink, want it done by March"></textarea></div>
            <div class="dz-actions">
              <button class="btn btn-red" type="button" id="dzSend">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91A9.86 9.86 0 0 0 12.04 2Zm5.8 14.06c-.24.68-1.42 1.3-1.95 1.35-.5.05-.97.23-3.27-.68-2.77-1.09-4.52-3.92-4.66-4.1-.13-.18-1.1-1.47-1.1-2.81s.7-1.99.95-2.27c.25-.27.54-.34.72-.34h.52c.17 0 .4-.06.62.47.24.56.8 1.94.86 2.08.07.14.12.3.02.48-.09.18-.14.3-.27.46l-.41.48c-.14.14-.28.29-.12.56.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.2 1.36.27.14.43.11.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.66-.17 1.33Z"/></svg>
                Send my design on WhatsApp
              </button>
              <a class="btn btn-line" id="dzEmail" href="#">Email it instead</a>
              <button class="btn btn-line" type="button" id="dzCopy">Copy design link</button>
            </div>
            <div class="dz-small">
              <button class="btn btn-line" type="button" id="dzUndo">Undo</button>
              <button class="btn btn-line" type="button" id="dzReset">Start again</button>
            </div>
            <p class="dz-note">Nothing is sent until you press send. The message includes a link that opens your exact design. Sizes are a starting point — we confirm everything on site before we build.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="toast" id="dzToast" role="status" aria-live="polite"></div>

  <script>
    import * as THREE from "three";
    import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";
    import { SITE } from "../data/site";

    // ================= catalogue =================
    type Row = { y0: number; h: number; d: number };
    type UT = { label: string; widths: number[]; def: number; front: string; extra?: string; top?: boolean; plinth?: boolean; carcass?: boolean; h?: number };
    const S = [100, 150, 200, 300, 450, 600, 900];
    const T: Record<string, UT> = {
      // kitchen floor
      door2: { label: "2-door base", widths: [600, 700, 800, 900, 1000], def: 800, front: "doors2", top: true, plinth: true },
      door1: { label: "1-door base", widths: [300, 400, 450, 500, 600], def: 450, front: "doors1", top: true, plinth: true },
      drawers: { label: "3-drawer base", widths: [400, 450, 500, 600, 800, 900], def: 600, front: "drawers3", top: true, plinth: true },
      sink: { label: "Sink unit", widths: [800, 900, 1000, 1200], def: 900, front: "doors", extra: "sink", top: true, plinth: true },
      oven: { label: "Oven + hob", widths: [600], def: 600, front: "oven", extra: "hob", top: true, plinth: true },
      dw: { label: "Dishwasher", widths: [600], def: 600, front: "panel", top: true, plinth: true, carcass: false },
      fridge: { label: "Fridge space", widths: [600, 700, 900], def: 700, front: "none", extra: "fridge", carcass: false },
      tall: { label: "Tall pantry", widths: [450, 500, 600], def: 600, front: "tall", plinth: true, h: 2100 },
      // kitchen wall
      wdoor1: { label: "1-door wall", widths: [300, 400, 450, 500, 600], def: 450, front: "doors1" },
      wdoor2: { label: "2-door wall", widths: [600, 700, 800, 900, 1000], def: 800, front: "doors2" },
      wlift: { label: "Lift-up wall", widths: [600, 800, 900, 1000, 1200], def: 900, front: "lift" },
      hood: { label: "Extractor", widths: [600, 900], def: 600, front: "none", extra: "hood", carcass: false },
      wshelf: { label: "Open shelf", widths: [600, 800, 900, 1200], def: 900, front: "none", extra: "shelf", carcass: false },
      // cupboards
      hang: { label: "Hanging", widths: [450, 500, 600, 800, 900, 1000], def: 900, front: "doors", plinth: true },
      shelves: { label: "Shelves", widths: [450, 500, 600], def: 500, front: "doors", plinth: true },
      hangdraw: { label: "Hanging + 2 drawers", widths: [800, 900, 1000], def: 900, front: "doors+2", plinth: true },
      drawshelf: { label: "Shelves + 3 drawers", widths: [450, 500, 600], def: 600, front: "doors+3", plinth: true },
      topbox: { label: "Top box", widths: [450, 500, 600, 800, 900, 1000], def: 900, front: "doors" },
      // vanity
      vbasin: { label: "Basin + 2 doors", widths: [600, 700, 800, 900, 1000], def: 800, front: "doors2", extra: "basin", top: true },
      vdraw: { label: "Basin + 2 drawers", widths: [600, 800, 900, 1000], def: 800, front: "drawers2", extra: "basin", top: true },
      vdouble: { label: "Double basin", widths: [1200, 1400, 1500, 1600], def: 1200, front: "doors4", extra: "basin2", top: true },
      vopen: { label: "Open shelf unit", widths: [300, 400, 450], def: 400, front: "open", top: true },
      mirror: { label: "Mirror", widths: [500, 600, 800, 900, 1000, 1200, 1400, 1600], def: 800, front: "none", extra: "mirror", carcass: false },
      mcab: { label: "Mirror cabinet", widths: [500, 600, 800, 900, 1000], def: 800, front: "mirrordoors" },
      // tv
      tvdraw: { label: "Drawer unit", widths: [600, 900, 1200], def: 900, front: "drawersH" },
      tvdoor: { label: "Door unit", widths: [450, 600, 900], def: 600, front: "doors" },
      tvopen: { label: "Open unit", widths: [450, 600, 900], def: 600, front: "open" },
      tvwall: { label: "Wall cabinet", widths: [600, 900, 1200], def: 900, front: "lift" },
      tvshelf: { label: "Floating shelf", widths: [600, 900, 1200, 1500], def: 900, front: "none", extra: "shelf", carcass: false },
      space: { label: "Gap / space", widths: S, def: 300, front: "none", carcass: false },
    };
    type Proj = { label: string; floor: Row; up: Row; fTypes: string[]; uTypes: string[]; fTitle: string; uTitle: string; fHelp: string; uHelp: string;
      topT: number; topD: number; plinthH: number; worktop: boolean; preset: { L: number; f: [string, number][]; u: [string, number][] } };
    const P: Record<string, Proj> = {
      kitchen: { label: "Kitchen", floor: { y0: 150, h: 720, d: 600 }, up: { y0: 1530, h: 720, d: 320 },
        fTypes: ["door2", "door1", "drawers", "sink", "oven", "dw", "fridge", "tall", "space"], uTypes: ["wdoor1", "wdoor2", "wlift", "hood", "wshelf", "space"],
        fTitle: "Floor units", uTitle: "Wall units", fHelp: "Left to right along the wall. Leave a gap for a fridge or stove that's staying.",
        uHelp: "Left to right. Use a gap to skip over a window or the tall pantry.", topT: 30, topD: 620, plinthH: 150, worktop: true,
        preset: { L: 3000, f: [["tall", 600], ["drawers", 600], ["sink", 900], ["oven", 600], ["door1", 300]], u: [["space", 600], ["wdoor2", 600], ["wdoor2", 900], ["hood", 600], ["wdoor1", 300]] } },
      cupboard: { label: "Built-in cupboard", floor: { y0: 100, h: 2100, d: 600 }, up: { y0: 2200, h: 500, d: 600 },
        fTypes: ["hang", "shelves", "hangdraw", "drawshelf", "space"], uTypes: ["topbox", "space"],
        fTitle: "Cupboard sections", uTitle: "Top boxes", fHelp: "Floor-to-2200 sections, left to right. Mix hanging, shelves and drawers.",
        uHelp: "Optional boxes above, up to ceiling height (about 2700).", topT: 0, topD: 0, plinthH: 100, worktop: false,
        preset: { L: 2400, f: [["hang", 900], ["drawshelf", 600], ["hangdraw", 900]], u: [["topbox", 900], ["topbox", 600], ["topbox", 900]] } },
      vanity: { label: "Vanity", floor: { y0: 380, h: 480, d: 460 }, up: { y0: 1150, h: 700, d: 150 },
        fTypes: ["vbasin", "vdraw", "vdouble", "vopen", "space"], uTypes: ["mirror", "mcab", "space"],
        fTitle: "Vanity units", uTitle: "Mirror", fHelp: "Wall-hung units with the basin on top.", uHelp: "A plain mirror or a mirror cabinet above.",
        topT: 20, topD: 470, plinthH: 0, worktop: true,
        preset: { L: 1400, f: [["vbasin", 900], ["vopen", 400]], u: [["mirror", 900]] } },
      tv: { label: "TV unit", floor: { y0: 250, h: 400, d: 450 }, up: { y0: 1650, h: 320, d: 300 },
        fTypes: ["tvdraw", "tvdoor", "tvopen", "space"], uTypes: ["tvwall", "tvshelf", "space"],
        fTitle: "Low units", uTitle: "Wall cabinets & shelves", fHelp: "Floating units under the TV.", uHelp: "Cabinets or shelves above. Leave a gap where the TV goes.",
        topT: 0, topD: 0, plinthH: 0, worktop: false,
        preset: { L: 2400, f: [["tvdoor", 600], ["tvdraw", 1200], ["tvdoor", 600]], u: [["tvwall", 600], ["space", 1200], ["tvwall", 600]] } },
    };
    // PG Bison MelaWood decors (on-screen colours are close matches, not exact)
    const DOORS: Record<string, { label: string; c: number; wood?: string; g: string }> = {
      white: { label: "White", c: 0xf2f1ee, g: "solid" },
      iceberg: { label: "Iceberg White", c: 0xf5f5f2, g: "solid" },
      folkstone: { label: "Folkstone Grey", c: 0xc8c3ba, g: "solid" },
      dunblane: { label: "Dunblane Grey", c: 0x8d8e8c, g: "solid" },
      stormgrey: { label: "Storm Grey", c: 0x4d5155, g: "solid" },
      superblack: { label: "Super Black", c: 0x1d1d1e, g: "solid" },
      petrol: { label: "Petrol Blue", c: 0x24475a, g: "solid" },
      cappuccino: { label: "Cappuccino", c: 0xa48b72, g: "solid" },
      summeroak: { label: "Summer Oak", c: 0xffffff, wood: "#c8a479", g: "wood" },
      monument: { label: "Monument Oak", c: 0xffffff, wood: "#ad8459", g: "wood" },
      shale: { label: "Shale Oak", c: 0xffffff, wood: "#8c8276", g: "wood" },
      walnut: { label: "American Walnut", c: 0xffffff, wood: "#6b4a32", g: "wood" },
      cherry: { label: "Black Cherry", c: 0xffffff, wood: "#5a3326", g: "wood" },
      wenge: { label: "African Wenge", c: 0xffffff, wood: "#3a2a22", g: "wood" },
      sprayed: { label: "Sprayed / painted (any colour)", c: 0xe9e4da, g: "spray" },
    };
    const TOPS: Record<string, { label: string; c: number; wood?: string; r: number }> = {
      quartz: { label: "White quartz", c: 0xebe8e2, r: .25 }, black: { label: "Black granite", c: 0x1d1d1f, r: .3 },
      oak: { label: "Oak", c: 0xffffff, wood: "#c09366", r: .5 }, concrete: { label: "Concrete grey", c: 0x9b9893, r: .7 },
    };
    const HANDLES: Record<string, { label: string; c: number; m: number }> = {
      black: { label: "Black bar", c: 0x151515, m: .7 }, steel: { label: "Brushed steel", c: 0xc7cacf, m: .9 },
      gold: { label: "Brushed gold", c: 0xc8a25a, m: .9 }, none: { label: "Handleless", c: 0, m: 0 },
    };

    // ================= state =================
    type U = [string, number];
    type D = { p: string; L: number; f: U[]; u: U[]; d: string; k: string; h: string };
    const presetOf = (p: string): D => { const x = P[p].preset; return { p, L: x.L, f: x.f.map(a => [...a] as U), u: x.u.map(a => [...a] as U), d: p === "kitchen" ? "stormgrey" : p === "cupboard" ? "white" : "monument", k: "quartz", h: "black" }; };
    function valid(x: any): D | null {
