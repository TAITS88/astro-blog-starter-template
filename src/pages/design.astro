            const chTop = st.ch; box(260, chTop - y0 - 130, 220, cx, (chTop + y0 + 130) / 2, 120, steel(), false);
          }
          if (ut.extra === "shelf") box(w, 32, d - 50, cx, y0 + (isFloor ? 0 : h / 2), (d - 50) / 2, doorM(true, u.c));
          if (ut.extra === "mirror") rbox(w, h, 6, cx, y0 + h / 2, 6, mirrorM(), 2);
          if (ut.extra === "basin" || ut.extra === "basin2") {
