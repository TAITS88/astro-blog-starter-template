      const target = new THREE.WebGLRenderTarget(1, 1, { type: THREE.HalfFloatType, samples: 4 });
      const composer = new EffectComposer(renderer, target);
      composer.addPass(new RenderPass(scene, camera));
      const ao = new N8AOPass(scene, camera, 1, 1);
      Object.assign(ao.configuration, { aoRadius: .45, distanceFalloff: .5, intensity: 3.2, color: new THREE.Color(0x1a140e), halfRes: true, denoiseRadius: 10, gammaCorrection: false });
      ao.setQualityMode("Medium");
      composer.addPass(ao);
      composer.addPass(new OutputPass());

      const statEl = $("dzPhotoStat");
      const sizesBtn = $("dzSizes");
      sizesBtn.addEventListener("click", () => { const on = labelsEl.classList.toggle("off"); sizesBtn.setAttribute("aria-pressed", String(!on)); });
      const resize = () => { W = stage.clientWidth; H = stage.clientHeight; renderer!.setSize(W, H, false); composer.setSize(W, H); ao.setSize(W, H); camera.aspect = W / H; camera.updateProjectionMatrix(); needsRender = true; hqDone = false; };
