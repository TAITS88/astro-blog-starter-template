            const sp = new THREE.Mesh(new THREE.TorusGeometry(.08, .011, 10, 24, Math.PI), steel()); sp.position.set(mm(cx), mm(topY) + .28, .17); sp.rotation.y = Math.PI / 2; cur.add(sp);
