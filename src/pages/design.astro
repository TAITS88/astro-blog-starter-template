      parent.add(o); return o;
    }
    function handle(cx: number, cy: number, z: number, len: number, vertical: boolean) {
      const hd = HANDLES[st.h]; if (st.h === "none") return;
      const m = std(hd.c, .3, hd.m);
      const b = new THREE.Mesh(new THREE.CylinderGeometry(.006, .006, mm(len), 12), m);
      if (!vertical) b.rotation.z = Math.PI / 2; b.position.set(mm(cx), mm(cy), mm(z + 28)); b.castShadow = true; root.add(b);
      for (const s of [-1, 1]) { const p = new THREE.Mesh(new THREE.CylinderGeometry(.005, .005, .028, 8), m); p.rotation.x = Math.PI / 2;
        p.position.set(mm(cx + (vertical ? 0 : s * (len / 2 - 15))), mm(cy + (vertical ? s * (len / 2 - 15) : 0)), mm(z + 14)); root.add(p); }
    }
    function label(text: string, x: number, y: number, z: number, up = false) {
      const e = el("div", "dz-lab" + (up ? " up" : ""), text); labelsEl.append(e); labs.push({ el: e, p: new THREE.Vector3(mm(x), mm(y), mm(z)) });
    }

    // fronts: returns pieces in unit-local mm (x from left, y from carcass bottom)
    type Piece = { x: number; y: number; w: number; h: number; kind: "door" | "drawer" | "glass" | "mirror"; side?: number };
    function fronts(front: string, w: number, h: number): Piece[] {
      const g = 3, out: Piece[] = [];
      const doors = (n: number, y0: number, y1: number, kind: Piece["kind"] = "door") => {
        const dw = (w - (n + 1) * g) / n;
        for (let i = 0; i < n; i++) out.push({ x: g + i * (dw + g), y: y0 + g / 2, w: dw, h: y1 - y0 - g, kind, side: n === 1 ? 1 : (i % 2 === 0 ? 1 : -1) });
      };
      const drawers = (n: number, y0: number, y1: number) => { const dh = (y1 - y0 - (n + 1) * g) / n; for (let i = 0; i < n; i++) out.push({ x: g / 2, y: y0 + g + i * (dh + g), w: w - g, h: dh, kind: "drawer" }); };
      const auto = w >= 700 ? 2 : 1;
      switch (front) {
        case "doors": doors(auto, 0, h); break;
        case "doors1": doors(1, 0, h); break;
        case "doors2": doors(2, 0, h); break;
        case "doors4": doors(4, 0, h); break;
        case "drawers3": drawers(3, 0, h); break;
        case "drawers2": drawers(2, 0, h); break;
        case "drawersH": { const n = w >= 900 ? 2 : 1, dw = (w - (n + 1) * g) / n; for (let i = 0; i < n; i++) out.push({ x: g + i * (dw + g), y: g, w: dw, h: h - 2 * g, kind: "drawer" }); break; }
        case "panel": out.push({ x: g / 2, y: g / 2, w: w - g, h: h - g, kind: "drawer" }); break;
        case "lift": out.push({ x: g / 2, y: g / 2, w: w - g, h: h - g, kind: "drawer", side: -1 }); break;
        case "tall": doors(auto, 0, 1400); doors(auto, 1400, h); break;
        case "oven": out.push({ x: g / 2, y: h - 595 - g / 2, w: w - g, h: 595, kind: "glass" }); out.push({ x: g / 2, y: g / 2, w: w - g, h: h - 595 - 2 * g, kind: "drawer" }); break;
        case "doors+2": drawers(2, 0, 420); doors(auto, 420, h); break;
        case "doors+3": drawers(3, 0, 620); doors(auto, 620, h); break;
        case "mirrordoors": doors(auto, 0, h, "mirror"); break;
