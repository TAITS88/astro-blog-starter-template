      camera.lookAt(tgt);
    }
    const v = new THREE.Vector3();
    function setLabelsPos() {
      for (const l of labs) {
        v.copy(l.p).project(camera);
        const vis = v.z < 1 && Math.abs(v.x) < 1.05 && Math.abs(v.y) < 1.05;
        l.el.style.display = vis ? "" : "none";
        l.el.style.left = `${(v.x * .5 + .5) * W}px`; l.el.style.top = `${(-v.y * .5 + .5) * H}px`;
      }
    }
    let needsRender = true, lastMove = 0, hqDone = false;
    if (renderer) {
      const coarse = matchMedia("(pointer: coarse)").matches;
      const basePR = Math.min(devicePixelRatio, coarse ? 1.5 : 2);
      renderer.setPixelRatio(basePR);
      renderer.outputColorSpace = THREE.SRGBColorSpace; renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.0;
      renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.VSMShadowMap;
      stage.prepend(renderer.domElement);
      scene.background = new THREE.Color(0xf3f1ed);
      RectAreaLightUniformsLib.init();
      // real interior lighting + reflections from a CC0 Poly Haven room HDRI
      const pmrem = new THREE.PMREMGenerator(renderer);
      new EXRLoader().load(roomHdr, tex => { scene.environment = pmrem.fromEquirectangular(tex).texture; tex.dispose(); needsRender = true; });
      const key = new THREE.DirectionalLight(0xfff1e0, 1.1); key.position.set(1.2, 4.5, 3.2); key.castShadow = true;
      key.shadow.mapSize.set(2048, 2048); Object.assign(key.shadow.camera, { left: -5, right: 5, top: 4, bottom: -2, near: .5, far: 15 });
      key.shadow.radius = 14; key.shadow.blurSamples = 20; key.shadow.bias = -.0005;
