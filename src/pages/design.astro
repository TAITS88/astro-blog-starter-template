      }
    }

    // camera
    let yaw = .32, pitch = .16, zoom = 1, W = 1, H = 1;
    const tgt = new THREE.Vector3();
    function fitView(resetAngles = false) { if (resetAngles) { yaw = .32; pitch = .16; zoom = 1; } }
    function placeCam() {
      let top = 900, zMax = 700, wide = st.r.a.L;
      for (const RN of RUNS) {
        const run = st.r[RN.k]; if (!run.on) continue;
        for (const [rowArr, f] of [[run.f, true], [run.u, false]] as const) for (const u of rowArr) { const dd = dims(u, f, RN.k); top = Math.max(top, dd.y + dd.h); }
        if (RN.k === "b" || RN.k === "c") zMax = Math.max(zMax, run.L);
        if (RN.k === "i" && run.f.length) { zMax = Math.max(zMax, ISLAND_Z + 700); wide = Math.max(wide, used(run.f)); }
      }
      top = Math.min(top + 150, st.ch);
      tgt.set(0, mm(top) / 2, mm(zMax) * .4);
