        else i.style.background = v.wood ? `repeating-linear-gradient(90deg, ${v.wood} 0 3px, ${v.wood}cc 3px 5px)` : `#${v.c.toString(16).padStart(6, "0")}`;
        b.append(i, document.createTextNode(v.label));
        b.addEventListener("click", () => change(() => { (st as any)[key] = k; }));
        h.append(b);
