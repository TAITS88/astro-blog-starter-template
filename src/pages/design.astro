          if ((ut.plinth || t === "custom") && isFloor && y0 >= 40 && ut.carcass !== false) box(w, y0, 16, cx, y0 / 2, d - 60, std(0x1c1c1c, .7), false);
          if (!isFloor && st.p === "kitchen" && ut.carcass !== false) {
            const led = new THREE.Mesh(new THREE.BoxGeometry(mm(w - 60), .004, .012), mat("led", () => new THREE.MeshStandardMaterial({ color: 0x222222, emissive: 0xffd9a8, emissiveIntensity: 4 })));
            led.position.set(mm(cx), mm(y0) - .003, mm(d - 50)); cur.add(led);
            const pool = new THREE.RectAreaLight(0xffc98f, 7, mm(w - 60), .03); pool.position.set(mm(cx), mm(y0) - .01, mm(d - 50)); pool.rotation.x = -Math.PI / 2; cur.add(pool);
